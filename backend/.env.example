# Groq API Configuration
GROQ_API_KEY=your_groq_api_key_here

# Server Configuration
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/bizshield-ai
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# Optional: Model Selection
# Available models:
# - llama3-8b-8192 (recommended for most use cases)
# - llama3-70b-8192 (more powerful, larger context)
# - mixtral-8x7b-32768 (good for reasoning, larger context)
# - gemma-7b-it (smaller, faster)
