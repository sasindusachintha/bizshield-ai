# Groq API Configuration
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_DAILY_TOKEN_LIMIT=100000

# Server Configuration
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/bizshield-ai
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# Optional: Model Selection
# Set GROQ_MODEL to a currently available Groq model if you want to change cost/speed/quality.
# Set GROQ_DAILY_TOKEN_LIMIT to match the Tokens Per Day limit shown in Groq Console.
